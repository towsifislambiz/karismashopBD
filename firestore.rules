rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Products Catalog: Publicly readable by all customers, fully manageable by Admin
    match /karishma_products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. Orders Collection: Real-time creation on checkout, live tracking & admin status updates
    match /karishma_orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }

    // 3. Store Configuration & Media Assets: Publicly readable, live updates from Admin Panel
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. Customer Accounts & Coins Wallet: Real-time login, profile, and coins management
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Default fallback rule for database connectivity
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
